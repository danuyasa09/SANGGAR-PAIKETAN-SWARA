#!/bin/bash
# =============================================================
# post-merge hook — otomatis berjalan setelah git pull
# Tempatkan/symlink file ini di .git/hooks/post-merge
# Jalankan: bash scripts/setup-hook.sh  (sekali saja)
# =============================================================

echo ""
echo "┌─────────────────────────────────────────────┐"
echo "│  🚀  Sanggar Paiketan Swara — Auto Deploy   │"
echo "└─────────────────────────────────────────────┘"
echo ""

# ---------- Composer ----------
echo "📦 Menjalankan composer install..."
composer install --no-dev --optimize-autoloader --no-interaction --quiet
echo "   ✅ Composer selesai."

# ---------- Artisan ----------
echo "🗄️  Menjalankan migrasi database..."
php artisan migrate --force --no-interaction
echo "   ✅ Migrasi selesai."

echo "⚙️  Membersihkan & membangun cache..."
php artisan config:cache   --quiet
php artisan route:cache    --quiet
php artisan view:cache     --quiet
echo "   ✅ Cache selesai."

# ---------- Storage symlink (hosting tanpa SSH sebelumnya) ----------
php artisan storage:link --quiet 2>/dev/null || true

echo ""
echo "✅  Deploy selesai! Aplikasi siap digunakan."
echo ""
